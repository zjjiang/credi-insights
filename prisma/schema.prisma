// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Card {
  id           String        @id @default(cuid())
  bank         String        // "CMB" | "SPDB" | ...
  cardLast4    String        // "0094"
  alias        String?       // 用户自定义别名
  billingDay   Int           // 账单日 1-31
  dueDay       Int           // 还款日 1-31
  imapHost     String        // "imap.qq.com"
  imapPort     Int           @default(993)
  imapUser     String        // "user@qq.com"
  imapPassword String        // 明文存储
  imapSubject  String        // "每日信用管家"
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  transactions Transaction[]
  uploads      Upload[]

  @@unique([bank, cardLast4])
}

model Upload {
  id           String        @id @default(cuid())
  originalName String
  filePath     String
  imageMonth   String?       // "2026-04"
  billingStart DateTime?     // 账期开始 2026-03-16
  billingEnd   DateTime?     // 账期结束 2026-04-15
  dueDate      DateTime?     // 还款日   2026-05-03
  cardLast4    String?       // "0094"
  cardId       String?
  card         Card?         @relation(fields: [cardId], references: [id], onDelete: SetNull)
  status       UploadStatus  @default(PENDING)
  parsedRawText String?  @db.Text
  txCount      Int           @default(0)
  createdAt    DateTime      @default(now())
  transactions Transaction[]
}

enum UploadStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

model Transaction {
  id          String    @id @default(cuid())
  uploadId    String?
  upload      Upload?   @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  cardId      String?
  card        Card?     @relation(fields: [cardId], references: [id], onDelete: SetNull)
  txDate      DateTime
  txTime      String?   // 精确交易时间 "HH:mm:ss"（日推送提供，月账单无）
  merchant    String
  amount      Decimal
  currency    String    @default("CNY")
  type        TxType    @default(DEBIT)
  cardLast4   String?
  txStatus    String?   // "未入账" / "已入账"
  source      String    @default("bill") // "bill"（月账单）| "daily"（日推送）
  graduatedFromDaily Boolean @default(false) // 曾由日推入库、后被月账单对账（供 UI 高亮）
  fingerprint String?   @unique // 去重指纹 `${date}_${cardLast4}_${amount}`
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  purpose     String?
  note        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

enum TxType {
  DEBIT
  CREDIT
}

model Setting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model Category {
  id           String        @id @default(cuid())
  name         String        @unique
  icon         String?
  color        String?
  isDefault    Boolean       @default(false)
  sortOrder    Int           @default(0)
  transactions Transaction[]
  rules        Rule[]
}

model Rule {
  id          String   @id @default(cuid())
  name        String
  description String   @db.Text
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  priority    Int      @default(0)
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
}
