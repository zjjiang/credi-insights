// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Upload {
  id           String        @id @default(cuid())
  originalName String
  filePath     String
  imageMonth   String?       // "2026-04"
  billingStart DateTime?     // 账期开始 2026-03-16
  billingEnd   DateTime?     // 账期结束 2026-04-15
  dueDate      DateTime?     // 还款日   2026-05-03
  cardLast4    String?       // "0094"
  status       UploadStatus  @default(PENDING)
  parsedRawText String?  @db.Text
  txCount      Int           @default(0)
  createdAt    DateTime      @default(now())
  transactions Transaction[]
}

enum UploadStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

model Transaction {
  id         String    @id @default(cuid())
  uploadId   String
  upload     Upload    @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  txDate     DateTime
  merchant   String
  amount     Decimal
  currency   String    @default("CNY")
  type       TxType    @default(DEBIT)
  cardLast4  String?
  txStatus   String?   // "未入账" / "已入账"
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])
  purpose    String?
  note       String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

enum TxType {
  DEBIT
  CREDIT
}

model Setting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model Category {
  id           String        @id @default(cuid())
  name         String        @unique
  icon         String?
  color        String?
  isDefault    Boolean       @default(false)
  sortOrder    Int           @default(0)
  transactions Transaction[]
  rules        Rule[]
}

model Rule {
  id          String   @id @default(cuid())
  name        String
  description String   @db.Text
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  priority    Int      @default(0)
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
}
