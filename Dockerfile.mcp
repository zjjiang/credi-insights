# MCP server image (stdio transport) for openclaw integration.
# Runs mcp-server.ts via tsx with full deps + generated Prisma client.
FROM node:22-slim

WORKDIR /app

# Python + extract-msg (sync_card -> runDailyIngest may shell out to parse_msg.py)
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip python3-venv \
  && rm -rf /var/lib/apt/lists/*

# Install all deps (need tsx + MCP SDK, which the runtime app image trims out).
# Use a fast mirror to avoid registry timeouts during build.
ARG NPM_REGISTRY=http://mirrors.cloud.tencent.com/npm/
COPY package.json package-lock.json ./
RUN npm config set registry "$NPM_REGISTRY" && npm ci

# App source needed by the MCP server (mcp-server.ts + src/lib/**)
COPY . .

# Generate Prisma client to src/generated/prisma (placeholder URL, real one at runtime)
RUN DATABASE_URL="mysql://placeholder:placeholder@localhost:3306/placeholder" npx prisma generate

# Python venv for msg parsing
RUN python3 -m venv .venv && .venv/bin/pip install --no-cache-dir \
    -i https://mirrors.cloud.tencent.com/pypi/simple \
    -r scripts/requirements.txt
ENV PYTHON_BIN=/app/.venv/bin/python3

ENV NODE_ENV=production

# stdio MCP server: JSON-RPC on stdout, logs on stderr
CMD ["npx", "tsx", "mcp-server.ts"]
